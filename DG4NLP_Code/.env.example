# Copy this file to `.env` and edit the values. NEVER commit or submit `.env`.
#
# LLM_BACKEND options:
#   none    -> LLM features disabled; the rest of the project works normally (default)
#   local   -> EASIEST: run an instruction-tuned model locally with transformers.
#              No install, no server, no key. Set only LLM_BACKEND=local
#              (optional: LLM_LOCAL_MODEL=google/flan-t5-base for a faster, smaller model)
#   openai  -> any OpenAI-compatible chat-completions endpoint. This covers:
#                * Ollama running locally (Option B, free, no key needed)
#                * a hosted API provider (Option A, needs a key, may cost money)
LLM_BACKEND=none

# --- Option B: local model via Ollama (https://ollama.com) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<name of a model you have pulled, e.g. a small instruct model>
# LLM_API_KEY=ollama

# --- Option A: hosted API (OpenAI-compatible) ---
# LLM_BASE_URL=https://<provider-endpoint>/v1
# LLM_MODEL=<provider model name>
# LLM_API_KEY=<your secret key>

LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_LOCAL_MODEL=google/flan-t5-large

# Force CPU even if a GPU is present (1 = yes, 0 = auto-detect)
FORCE_CPU=0
